# Copy this file to `.env` and fill in real values.
# .env is git-ignored on purpose — never commit real secrets (see Slide 5, L3).

FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# --- Database ---
# Leave unset to use the bundled SQLite file at instance/nwr_bi.db (fastest
# way to run the demo). For Phase 2 with real PostgreSQL, uncomment:
# DATABASE_URL=postgresql://nwr_user:your_password@localhost:5432/nwr_bi

# --- CiMSO Innkeeper API ---
CIMSO_USE_MOCK=true
CIMSO_API_BASE_URL=https://mock-cimso.local/api/v1
CIMSO_API_KEY=
CIMSO_SYNC_INTERVAL_MINUTES=15

# --- Cookies ---
# Set to true once the app is served over HTTPS in production.
FORCE_SECURE_COOKIES=false
